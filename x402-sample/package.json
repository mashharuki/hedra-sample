{
  "name": "x402-sample",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm --recursive run build",
    "dev:server": "pnpm --filter @x402-sample/server dev",
    "run:client": "pnpm --filter @x402-sample/client start",
    "test:live": "pnpm --filter @x402-sample/client test:live",
    "frontend": "pnpm --filter frontend",
    "test": "pnpm --recursive run test",
    "lint": "biome check .",
    "format:check": "biome format .",
    "knip": "knip",
    "check": "pnpm format:check && pnpm lint && pnpm knip && pnpm build && pnpm test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.10",
    "knip": "5.83.0"
  }
}
