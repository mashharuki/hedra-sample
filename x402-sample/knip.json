{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    "apps/server": {
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "apps/client": {
      "project": ["src/**/*.ts"]
    },
    "apps/frontend": {
      "entry": [
        "src/main.tsx",
        "scripts/fund-wallet.ts",
        "vite.config.ts",
        "vitest.config.ts"
      ],
      "project": ["src/**/*.{ts,tsx}", "scripts/**/*.ts"],
      "ignoreDependencies": ["dotenv"]
    }
  }
}
